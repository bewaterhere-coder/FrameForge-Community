  "advisories": [
    {
      "id": "unreal-project-plugins",
      "topic": "Project plugin provenance",
      "any_paths": [
        "Plugins"
      ],
      "recommendation": "Review project plugin descriptors, source/binary availability, engine-version compatibility, license and ownership. A Plugins directory alone does not prove a problem."
    },
    {
      "id": "unreal-source-modules",
      "topic": "C++ module boundaries",
      "any_paths": [
        "Source"
      ],
      "recommendation": "For C++ projects, review module boundaries and Build.cs dependencies against the project-owned architecture standard. Blueprint-only projects do not require a Source directory."
    }
  ],
